<Window x:Class="Glass.GroupBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Group Browser" Height="600" Width="500">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button x:Name="ButtonRefresh" Content="Refresh"
                    Click="Button_Refresh_Click" Padding="8,4"/>
        </StackPanel>
        <TextBlock x:Name="ResultCount" DockPanel.Dock="Top" Margin="4,0,4,4"
                   Text="Not yet refreshed"/>
        <TreeView x:Name="MembershipTree" Margin="4"/>
    </DockPanel>
</Window>