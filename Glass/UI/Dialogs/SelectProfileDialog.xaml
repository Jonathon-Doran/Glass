<Window x:Class="Glass.SelectProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Manage Profiles"
        Height="460" Width="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">

        <CheckBox x:Name="ShowDeletedCheckBox" DockPanel.Dock="Top" Content="Show deleted"
                  Margin="0,0,0,8"
                  Checked="ShowDeletedCheckBox_Changed" Unchecked="ShowDeletedCheckBox_Changed"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="EditButton" Content="Edit" Width="80" Margin="0,0,8,0"
                    IsEnabled="False" Click="Edit_Click"/>
            <Button x:Name="RenameButton" Content="Rename" Width="80" Margin="0,0,8,0"
                    IsEnabled="False" Click="Rename_Click"/>
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Margin="0,0,8,0"
                    IsEnabled="False" Click="Delete_Click"/>
            <Button x:Name="RestoreButton" Content="Restore" Width="80" Margin="0,0,8,0"
                    IsEnabled="False" Visibility="Collapsed" Click="Restore_Click"/>
            <Button x:Name="EmptyDeletedButton" Content="Empty Deleted" Width="110" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="EmptyDeleted_Click"/>
            <Button Content="Close" Width="80" Click="Close_Click"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Description:" VerticalAlignment="Center" Width="80"/>
            <Button x:Name="SaveDescriptionButton" DockPanel.Dock="Right" Content="Save Description"
                    Width="120" Margin="8,0,0,0" IsEnabled="False" Click="SaveDescription_Click"/>
            <TextBox x:Name="DescriptionTextBox" TextChanged="DescriptionTextBox_TextChanged"/>
        </DockPanel>
        
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Name:" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="NameTextBox" TextChanged="NameTextBox_TextChanged"/>
        </DockPanel>

        <ListView x:Name="ProfileList"
                  SelectionChanged="ProfileList_SelectionChanged"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Profile" Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Server" Width="120" DisplayMemberBinding="{Binding Server}"/>
                    <GridViewColumn Header="Characters" Width="80" DisplayMemberBinding="{Binding CharacterCount}"/>
                    <GridViewColumn Header="Description" Width="340" DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>