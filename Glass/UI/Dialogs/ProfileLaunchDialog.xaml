<Window x:Class="Glass.ProfileLaunchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Launch Profile"
        Height="460" Width="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="LaunchButton" Content="Launch" Width="80" Margin="0,0,8,0"
                    IsEnabled="False" Click="Launch_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>

        <ListView x:Name="ProfileList"
                  SelectionChanged="ProfileList_SelectionChanged"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Profile" Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Server" Width="120" DisplayMemberBinding="{Binding Server}"/>
                    <GridViewColumn Header="Characters" Width="80" DisplayMemberBinding="{Binding CharacterCount}"/>
                    <GridViewColumn Header="Description" Width="340" DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>