<Window x:Class="Inference.Dialogs.PacketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Packet Detail"
        Height="600" Width="1000"
        PreviewKeyDown="Window_PreviewKeyDown"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow"
                                  Stroke="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"
                                  Data="M 3 1 L 10 6 L 3 11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TightTreeViewItem" TargetType="{x:Type TreeViewItem}">
            <Setter Property="Padding" Value="1,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0" Grid.Column="0"
                                          Style="{StaticResource ExpandCollapseToggleStyle}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center"/>

                            <Border x:Name="Bd"
                                    Grid.Row="0" Grid.Column="1"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted, NotifyOnTargetUpdated=True}" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                     Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Packet:" FontWeight="SemiBold" Margin="0,0,4,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HeaderPacketIndex" Margin="0,0,16,2"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Timestamp:" FontWeight="SemiBold" Margin="0,0,4,2"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="HeaderTimestamp" Margin="0,0,16,2"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Length:" FontWeight="SemiBold" Margin="0,0,4,2"/>
                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="HeaderLength" Margin="0,0,16,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Opcode:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HeaderOpcode" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Channel:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="HeaderChannel" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Character:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="HeaderCharacter" Margin="0,0,16,0"/>
            </Grid>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusHexCursor" Text="No cursor" Margin="0,0,16,0"/>
                    <Separator/>
                    <TextBlock x:Name="StatusHexMatches" Text="No matches" Margin="16,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Fields" FontWeight="SemiBold" Margin="8,4,8,2"/>
                <TreeView x:Name="FieldTree"
                          Margin="8,0,4,8"
                          BorderThickness="0"
                          PreviewKeyDown="FieldTree_PreviewKeyDown"
                          Background="Transparent"
                          PreviewMouseMove="FieldTree_MouseMove" 
                          PreviewMouseLeftButtonDown="FieldTree_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FieldTree_PreviewMouseLeftButtonUp"
                          ItemContainerStyle="{StaticResource TightTreeViewItem}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Text}"
                                       FontFamily="Consolas"
                                       Height="20"
                                       FontSize="13"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Hex" FontWeight="SemiBold" Margin="8,4,8,2"/>

                <StackPanel DockPanel.Dock="Top" x:Name="HexPalettePanel"
                            Orientation="Vertical" Margin="8,0,8,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Border x:Name="HexPatchYellow" Background="#FFFFE066" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFFFE066" ToolTip="Yellow — click to arm, right-click to erase all yellow highlights"/>
                        <Border x:Name="HexPatchGreen" Background="#FF6BCB77" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF6BCB77" ToolTip="Green — click to arm, right-click to erase all green highlights"/>
                        <Border x:Name="HexPatchCyan" Background="#FF4DD0E1" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF4DD0E1" ToolTip="Cyan — click to arm, right-click to erase all cyan highlights"/>
                        <Border x:Name="HexPatchMagenta" Background="#FFE066C7" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFE066C7" ToolTip="Magenta — click to arm, right-click to erase all magenta highlights"/>
                        <Border x:Name="HexPatchSalmon" Background="#FFFF9999" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFFF9999" ToolTip="Salmon — click to arm, right-click to erase all salmon highlights"/>
                        <Border x:Name="HexPatchOrange" Background="#FFFFB347" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFFFB347" ToolTip="Orange — click to arm, right-click to erase all orange highlights"/>
                        <Border x:Name="HexPatchLime" Background="#FFC5E063" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFC5E063" ToolTip="Lime — click to arm, right-click to erase all lime highlights"/>
                        <Border x:Name="HexPatchLavender" Background="#FFC9A0DC" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFFC9A0DC" ToolTip="Lavender — click to arm, right-click to erase all lavender highlights"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="HexPatchNavy" Background="#FF1F4E9C" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF1F4E9C" ToolTip="Navy — click to arm, right-click to erase all navy highlights"/>
                        <Border x:Name="HexPatchForest" Background="#FF2E7D32" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF2E7D32" ToolTip="Forest Green — click to arm, right-click to erase all forest green highlights"/>
                        <Border x:Name="HexPatchTeal" Background="#FF00695C" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF00695C" ToolTip="Teal — click to arm, right-click to erase all teal highlights"/>
                        <Border x:Name="HexPatchMaroon" Background="#FF8E1F2F" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF8E1F2F" ToolTip="Maroon — click to arm, right-click to erase all maroon highlights"/>
                        <Border x:Name="HexPatchPurple" Background="#FF5E35B1" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF5E35B1" ToolTip="Purple — click to arm, right-click to erase all purple highlights"/>
                        <Border x:Name="HexPatchBrown" Background="#FF6D4C41" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF6D4C41" ToolTip="Brown — click to arm, right-click to erase all brown highlights"/>
                        <Border x:Name="HexPatchSlate" Background="#FF455A64" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF455A64" ToolTip="Slate — click to arm, right-click to erase all slate highlights"/>
                        <Border x:Name="HexPatchOlive" Background="#FF7A6A21" Width="24" Height="24"
                                Margin="2,0" BorderBrush="Gray" BorderThickness="1"
                                MouseLeftButtonUp="HexColorPatch_MouseLeftButtonUp"
                                Tag="0xFF7A6A21" ToolTip="Olive — click to arm, right-click to erase all olive highlights"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                        <ToggleButton x:Name="ToggleHexColorSelected"
                                      Content="Color selected"
                                      Click="Toggle_HexColorSelected_Click"
                                      Padding="8,4"
                                      ToolTip="Color the selected hex text in the armed color"/>
                        <ToggleButton x:Name="ToggleHexUncolorSelected"
                                      Content="Uncolor selected"
                                      Click="Toggle_HexUncolorSelected_Click"
                                      Padding="8,4" Margin="8,0,0,0"
                                      ToolTip="Remove hand coloring from the selected hex text"/>
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="HexFindBar" DockPanel.Dock="Top"
                      Margin="8,0,8,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="1"
                             x:Name="TextBoxHexFind"
                             Width="240"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             KeyDown="TextBoxHexFind_KeyDown"/>
                    <Button Grid.Column="2"
                            x:Name="ButtonHexFindClear"
                            Content="✕"
                            Click="Button_HexFindClear_Click"
                            Padding="4,2" Margin="2,0,0,0"
                            ToolTip="Clear search text"/>
                    <Button Grid.Column="3"
                            x:Name="ButtonHexFindPrevious"
                            Content="▲"
                            Click="Button_HexFindPrevious_Click"
                            Padding="6,2" Margin="8,0,0,0"
                            ToolTip="Find previous (Shift+Enter)"/>
                    <Button Grid.Column="4"
                            x:Name="ButtonHexFindNext"
                            Content="▼"
                            Click="Button_HexFindNext_Click"
                            Padding="6,2" Margin="2,0,0,0"
                            ToolTip="Find next (Enter)"/>
                    <Button Grid.Column="5"
                            x:Name="ButtonHexFindAll"
                            Content="Find"
                            Click="Button_HexFindAll_Click"
                            Padding="8,2" Margin="4,0,0,0"
                            ToolTip="Highlight all matches"/>
                    <CheckBox Grid.Column="6"
                              x:Name="CheckBoxHexFindWrap"
                              Content="Wrap"
                              Width="70"
                              MinWidth="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="8,0,0,0"
                              ToolTip="Wrap around at end of dump"/>
                    <Button Grid.Column="7"
                            x:Name="ButtonHexFindClose"
                            Content="✕"
                            Click="Button_HexFindClose_Click"
                            Padding="6,2" Margin="12,0,0,0"
                            ToolTip="Close find bar (Esc)"/>
                </Grid>
                <RichTextBox x:Name="HexDumpBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             FontFamily="Consolas"
                             FontSize="13"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="4,0,8,8"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>