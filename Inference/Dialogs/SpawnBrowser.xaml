<Window x:Class="Inference.Dialogs.SpawnBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Spawn Browser" Height="600" Width="1000">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <TextBlock Text="Zone:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="ZoneList" MinWidth="200" Margin="0,0,12,0"
                      SelectionChanged="ZoneList_SelectionChanged"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="FilterText" Width="160" Margin="0,0,12,0"
                     ToolTip="Name substring, or spawn id in decimal or 0x hex."
                     KeyDown="FilterText_KeyDown"/>
            <Button x:Name="ButtonRefresh" Content="Refresh"
                    Click="Button_Refresh_Click" Padding="8,4"/>
        </StackPanel>
        <TextBlock x:Name="ResultCount" DockPanel.Dock="Top" Margin="4,0,4,4"
                   Text="No zone selected"/>
        <DataGrid x:Name="ResultGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  VirtualizingStackPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Spawn Id" Width="Auto" Binding="{Binding SpawnIdHex}"/>
                <DataGridTextColumn Header="Name" Width="Auto" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Level" Width="Auto" Binding="{Binding Level}"/>
                <DataGridTextColumn Header="Mob Id" Width="Auto" Binding="{Binding MobId}"/>
                <DataGridTextColumn Header="Persistent Id" Width="Auto" Binding="{Binding PersistentId}"/>
                <DataGridTextColumn Header="Player" Width="Auto" Binding="{Binding IsPlayer}"/>
                <DataGridTextColumn Header="Type" Width="Auto" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Model" Width="Auto" Binding="{Binding Model}"/>
                <DataGridTextColumn Header="Class" Width="Auto" Binding="{Binding Class}"/>
                <DataGridTextColumn Header="A" Width="Auto" Binding="{Binding A}"/>
                <DataGridTextColumn Header="C" Width="Auto" Binding="{Binding C}"/>
                <DataGridTextColumn Header="Unknown 1" Width="Auto" Binding="{Binding Unknown1}"/>
                <DataGridTextColumn Header="Unknown 2" Width="Auto" Binding="{Binding Unknown2}"/>
                <DataGridTextColumn Header="Unknown 3" Width="Auto" Binding="{Binding Unknown3}"/>
                <DataGridTextColumn Header="Lastname" Width="Auto" Binding="{Binding LastName}"/>
                <DataGridTextColumn Header="Owner Spawn Id" Width="Auto" Binding="{Binding OwnerId}"/>
                <DataGridTextColumn Header="X" Width="Auto" Binding="{Binding X, StringFormat=F1}"/>
                <DataGridTextColumn Header="Y" Width="Auto" Binding="{Binding Y, StringFormat=F1}"/>
                <DataGridTextColumn Header="Z" Width="Auto" Binding="{Binding Z, StringFormat=F1}"/>
                <DataGridTextColumn Header="Observed" Width="Auto" Binding="{Binding Observed}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
