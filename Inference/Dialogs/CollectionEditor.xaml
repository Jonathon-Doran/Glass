<Window x:Class="Inference.Dialogs.CollectionEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:uiconv="clr-namespace:Inference.UI"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Collection Editor"
        Width="1100"
        Height="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <uiconv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <uiconv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <uiconv:AnchorFoundConverter x:Key="AnchorFound" />
        <uiconv:AnchorMatchConverter x:Key="AnchorMatch" />
        <Style x:Key="NoDetailChromeRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="DetailsVisibility"
                Value="{Binding any_detail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <Style x:Key="AlternatingRowHeaderStyle"
               TargetType="DataGridRowHeader"
               BasedOn="{StaticResource {x:Type DataGridRowHeader}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             Value="1">
                    <Setter Property="Background" Value="#FFDA70D6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =========================================================================== -->
        <!-- Top:  Patch level + collection selectors                                    -->
        <!-- =========================================================================== -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="Patch:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="PatchLevelComboBox"
                      Width="240"
                      Margin="0,0,16,0"
                      SelectionChanged="PatchLevelComboBox_SelectionChanged" />

            <TextBlock Text="Collection:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="CollectionComboBox"
                      Width="280"
                      Margin="0,0,8,0"
                      SelectionChanged="CollectionComboBox_SelectionChanged" />
            <Button x:Name="NewCollectionButton"
                    Content="New"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="NewCollectionButton_Click" />
            <Button x:Name="DeleteCollectionButton"
                    Content="Delete"
                    Width="80"
                    Margin="0,0,16,0"
                    Click="DeleteCollectionButton_Click" />

            <TextBlock Text="Name:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="CollectionNameTextBox"
                     Width="240"
                     Margin="0,0,16,0" />
        </StackPanel>

        <!-- =========================================================================== -->
        <!-- Row 1:  PacketField grid                                                    -->
        <!-- =========================================================================== -->
        <GroupBox Grid.Row="1"
                  Header="Fields"
                  Margin="0,0,0,8">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <Button x:Name="AddFieldButton"
                            Content="Add"
                            Width="60"
                            Margin="0,0,4,0"
                            Click="AddFieldButton_Click" />
                    <Button x:Name="DeleteFieldButton"
                            Content="Delete"
                            Width="60"
                            Margin="0,0,16,0"
                            Click="DeleteFieldButton_Click" />

                    <Button x:Name="ToggleRelativeToButton"
                            Content="Relative To"
                            Width="90"
                            Margin="0,0,4,0"
                            Click="ToggleRelativeToButton_Click" />
                    <Button x:Name="ToggleGateButton"
                            Content="Gate"
                            Width="60"
                            Margin="0,0,4,0"
                            Click="ToggleGateButton_Click" />
                    <Button x:Name="TogglePredicateButton"
                            Content="Predicate"
                            Width="80"
                            Click="TogglePredicateButton_Click" />
                    <Button x:Name="RenumberButton"
                            Content="Renumber"
                            Width="90"
                            Margin="16,0,0,0"
                            Click="RenumberButton_Click" />
                </StackPanel>

                <DataGrid x:Name="FieldsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="All"
                          SelectionMode="Single"
                          AlternationCount="2"
                          RowStyle="{StaticResource NoDetailChromeRowStyle}"
                          RowHeaderStyle="{StaticResource AlternatingRowHeaderStyle}"
                          VerticalAlignment="Top">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="InsertRowHereMenuItem"
                                  Header="Insert Row Here"
                                  Click="InsertRowHereMenuItem_Click" />
                            <MenuItem x:Name="RemoveGapsMenuItem"
                                  Header="Remove Gaps"
                                  Click="RemoveGapsMenuItem_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                            Binding="{Binding sequence}"
                            Width="80" />
                        <DataGridTextColumn Header="Name"
                            Binding="{Binding field_name}"
                            Width="*">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell"
                                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource AnchorMatch}" Mode="OneWay">
                                                    <Binding Path="field_name" />
                                                    <Binding Path="SelectedItem.relative_to"
                                                             RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="#FF8A6D00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Bit Offset"
                            Binding="{Binding bit_offset}"
                            Width="80" />
                        <DataGridTextColumn Header="Bit Length"
                            Binding="{Binding bit_length}"
                            Width="80" />
                        <DataGridComboBoxColumn x:Name="FieldEncodingColumn"
                            Header="Encoding"
                            SelectedValueBinding="{Binding encoding}"
                            Width="160" />
                        <DataGridTextColumn Header="Divisor"
                            Binding="{Binding divisor}"
                            Width="70" />
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical"
                                        Margin="105,2,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Relative To -->
                                    <Grid Margin="0,0,16,0">
                                        <Grid.Visibility>
                                            <MultiBinding Converter="{StaticResource StringToVisibility}" Mode="OneWay">
                                                <Binding Path="relative_to" />
                                                <Binding Path="show_relative_to" />
                                            </MultiBinding>
                                        </Grid.Visibility>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                            Text="Relative To:"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1"
                                            MinWidth="120"
                                            HorizontalAlignment="Left"
                                            BorderThickness="0"
                                            Text="{Binding relative_to, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Tag>
                                                <MultiBinding Converter="{StaticResource AnchorFound}" Mode="OneWay">
                                                    <Binding Path="relative_to" />
                                                    <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    <Binding Path="FieldNamesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </TextBox.Tag>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox"
                                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                     Value="True">
                                                            <Setter Property="Foreground" Value="#FF4CD964" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                     Value="False">
                                                            <Setter Property="Foreground" Value="#FFFF5C5C" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                           Value="True" />
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                           Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#FF8A6D00" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>

                                    <!-- Gate -->
                                    <Grid Margin="0,0,16,0">
                                        <Grid.Visibility>
                                            <MultiBinding Converter="{StaticResource StringToVisibility}" Mode="OneWay">
                                                <Binding Path="gate" />
                                                <Binding Path="show_gate" />
                                            </MultiBinding>
                                        </Grid.Visibility>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                            Text="Gate:"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1"
                                            MinWidth="120"
                                            HorizontalAlignment="Left"
                                            IsEditable="True"
                                            ItemsSource="{Binding KnownGateNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Text="{Binding gate, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Predicate -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.Visibility>
                                        <MultiBinding Converter="{StaticResource StringToVisibility}" Mode="OneWay">
                                            <Binding Path="predicate" />
                                            <Binding Path="show_predicate" />
                                        </MultiBinding>
                                    </Grid.Visibility>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                        Text="Predicate:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1"
                                        MinWidth="400"
                                        MaxWidth="700"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="False"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Text="{Binding predicate, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- =========================================================================== -->
        <!-- Bottom:  Status bar + Save / Close                                          -->
        <!-- =========================================================================== -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                Content="Save"
                Width="80"
                Margin="0,0,8,0"
                Click="SaveButton_Click" />
                <Button x:Name="CloseButton"
                Content="Close"
                Click="CloseButton_Click" />
            </StackPanel>
            <StatusBar>
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="" />
                </StatusBarItem>
            </StatusBar>
        </DockPanel>
    </Grid>
</Window>